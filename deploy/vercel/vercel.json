{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/index.py": {"maxDuration": 30, "excludeFiles": "public/**"}
  },
  "rewrites": [
    {"source": "/api/catalog", "destination": "/api/index?operation=catalog"},
    {"source": "/api/plan", "destination": "/api/index?operation=plan"},
    {"source": "/api/generate", "destination": "/api/index?operation=generate"},
    {"source": "/api/restore", "destination": "/api/index?operation=restore"},
    {"source": "/api/check", "destination": "/api/index?operation=check"}
  ],
  "headers": [{"source": "/(.*)", "headers": [
    {"key": "X-Content-Type-Options", "value": "nosniff"},
    {"key": "Referrer-Policy", "value": "same-origin"},
    {"key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"}
  ]}]
}
